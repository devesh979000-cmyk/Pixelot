<!DOCTYPE html>
<html lang="en" class="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Universal AI Chat</title>
    
    <!-- Tailwind CSS (Zero Build) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        gemini: {
                            light: '#f0f4f9',
                            dark: '#1e1f22',
                            bubbleLight: '#e3e3e3',
                            bubbleDark: '#2b2d31'
                        }
                    }
                }
            }
        }
    </script>
    
    <!-- Marked.js for Markdown parsing -->
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    
    <!-- Font Awesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        /* Markdown Rendering Styles */
        .markdown-body { font-size: 1rem; line-height: 1.6; }
        .markdown-body p { margin-bottom: 1em; }
        .markdown-body pre { background-color: #1a1b26; color: #a9b1d6; padding: 1rem; border-radius: 0.5rem; overflow-x: auto; margin-top: 0.5rem; margin-bottom: 1rem; font-family: monospace; font-size: 0.875rem; border: 1px solid #2d3748; }
        .markdown-body code { font-family: monospace; background-color: rgba(128,128,128,0.15); padding: 0.15rem 0.3rem; border-radius: 0.25rem; font-size: 0.875em; }
        .markdown-body pre code { background-color: transparent; padding: 0; color: inherit; }
        .markdown-body h1, .markdown-body h2, .markdown-body h3 { font-weight: 600; margin-top: 1.5em; margin-bottom: 0.5em; }
        .markdown-body ul { list-style-type: disc; padding-left: 1.5em; margin-bottom: 1em; }
        .markdown-body ol { list-style-type: decimal; padding-left: 1.5em; margin-bottom: 1em; }
        .markdown-body blockquote { border-left: 4px solid #cbd5e1; padding-left: 1em; color: #64748b; margin-bottom: 1em; }
        .dark .markdown-body blockquote { border-left-color: #475569; color: #94a3b8; }
        .markdown-body a { color: #3b82f6; text-decoration: underline; }
        
        /* Layout overrides to prevent h-screen + overflow-hidden combination */
        body { min-height: 100dvh; display: flex; flex-direction: row; }
        .typing-cursor::after { content: '▋'; animation: blink 1s step-start infinite; color: #3b82f6; }
        @keyframes blink { 50% { opacity: 0; } }
        
        /* Smooth transitions */
        .transition-all { transition-property: all; transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1); transition-duration: 300ms; }
    </style>
</head>
<body class="bg-white dark:bg-[#131314] text-gray-800 dark:text-gray-200 font-sans antialiased selection:bg-blue-200 dark:selection:bg-blue-900">

    <!-- Mobile Sidebar Overlay -->
    <div id="sidebarOverlay" class="fixed inset-0 bg-black/50 z-40 hidden md:hidden transition-opacity" onclick="toggleSidebar()"></div>

    <!-- Left Sidebar -->
    <aside id="sidebar" class="fixed md:sticky top-0 h-[100dvh] w-72 bg-gemini-light dark:bg-gemini-dark border-r border-gray-200 dark:border-gray-800 z-50 transform -translate-x-full md:translate-x-0 transition-transform duration-300 flex flex-col shrink-0">
        <div class="p-4">
            <button onclick="createNewChat()" class="w-full flex items-center gap-2 bg-white dark:bg-[#2b2d31] hover:bg-gray-50 dark:hover:bg-[#383a40] text-gray-800 dark:text-gray-200 rounded-full px-4 py-3 shadow-sm transition-colors border border-gray-200 dark:border-gray-700 font-medium">
                <i class="fas fa-plus text-blue-500"></i> New Chat
            </button>
        </div>

        <div class="flex-1 overflow-y-auto px-3 py-2">
            <h3 class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-2 px-2">Recent Chats</h3>
            <div id="chatHistoryList" class="space-y-1">
                <!-- Chat history injected here -->
            </div>
        </div>

        <div class="p-4 border-t border-gray-200 dark:border-gray-800 space-y-2">
            <button onclick="openSystemPromptModal()" class="w-full flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-gray-200 dark:hover:bg-[#2b2d31] transition-colors text-sm">
                <i class="fas fa-robot text-gray-500 dark:text-gray-400 w-5"></i> System Prompt
            </button>
            <button onclick="openSettingsModal()" class="w-full flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-gray-200 dark:hover:bg-[#2b2d31] transition-colors text-sm">
                <i class="fas fa-cog text-gray-500 dark:text-gray-400 w-5"></i> Settings
            </button>
        </div>
    </aside>

    <!-- Main Chat Area -->
    <main class="flex-1 flex flex-col min-h-[100dvh] w-full relative">
        <!-- Sticky Header -->
        <header class="sticky top-0 z-30 flex items-center justify-between px-4 py-3 bg-white/80 dark:bg-[#131314]/80 backdrop-blur-md border-b border-gray-200 dark:border-gray-800">
            <div class="flex items-center gap-3">
                <button onclick="toggleSidebar()" class="md:hidden p-2 -ml-2 rounded-full hover:bg-gray-100 dark:hover:bg-gray-800 text-gray-600 dark:text-gray-300">
                    <i class="fas fa-bars text-lg"></i>
                </button>
                <h1 id="currentChatTitle" class="font-medium text-lg truncate max-w-[200px] sm:max-w-md">New Chat</h1>
            </div>
            <button onclick="toggleDarkMode()" class="p-2 rounded-full hover:bg-gray-100 dark:hover:bg-gray-800 text-gray-600 dark:text-gray-300 transition-colors">
                <i id="themeIcon" class="fas fa-moon text-lg"></i>
            </button>
        </header>

        <!-- Messages Container -->
        <div id="chatContainer" class="flex-1 w-full max-w-4xl mx-auto p-4 md:p-6 pb-8 space-y-6">
            <!-- Initial Greeting -->
            <div id="welcomeMessage" class="flex flex-col items-center justify-center h-full text-center space-y-4 opacity-50 mt-12">
                <i class="fas fa-sparkles text-4xl text-blue-500 mb-2"></i>
                <h2 class="text-2xl font-semibold">How can I help you today?</h2>
                <p class="text-sm">Powered by OpenRouter API</p>
            </div>
        </div>

        <!-- Sticky Input Area -->
        <div class="sticky bottom-0 z-30 bg-white dark:bg-[#131314] px-4 py-4 md:py-6 border-t md:border-none border-gray-200 dark:border-gray-800">
            <div class="max-w-4xl mx-auto relative">
                <div class="flex items-end bg-gray-100 dark:bg-[#1e1f22] rounded-3xl p-2 md:p-3 border border-transparent focus-within:border-gray-300 dark:focus-within:border-gray-600 transition-colors shadow-sm">
                    <textarea 
                        id="messageInput" 
                        rows="1" 
                        class="w-full max-h-[200px] bg-transparent border-none focus:ring-0 resize-none px-4 py-3 text-base text-gray-900 dark:text-gray-100 placeholder-gray-500 dark:placeholder-gray-400 outline-none" 
                        placeholder="Ask me anything..."
                        oninput="autoResizeTextarea(this)"
                        onkeydown="handleEnter(event)"></textarea>
                    
                    <button id="sendBtn" onclick="handleSend()" class="m-1 p-3 rounded-full bg-blue-600 text-white hover:bg-blue-700 disabled:bg-gray-400 dark:disabled:bg-gray-600 disabled:cursor-not-allowed transition-colors shrink-0 flex items-center justify-center h-12 w-12">
                        <i class="fas fa-arrow-up text-lg"></i>
                    </button>
                </div>
                <div class="text-center mt-3 text-xs text-gray-500 dark:text-gray-400">
                    AI interfaces can make mistakes. Verify important information.
                </div>
            </div>
        </div>
    </main>

    <!-- Modals -->

    <!-- Settings Modal -->
    <div id="settingsModal" class="fixed inset-0 bg-black/60 z-[100] hidden flex items-center justify-center p-4">
        <div class="bg-white dark:bg-[#1e1f22] rounded-2xl w-full max-w-md shadow-xl overflow-hidden transform scale-95 transition-transform">
            <div class="px-6 py-4 border-b border-gray-200 dark:border-gray-700 flex justify-between items-center">
                <h2 class="text-lg font-semibold">Settings</h2>
                <button onclick="closeModal('settingsModal')" class="text-gray-500 hover:text-gray-800 dark:hover:text-white">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div class="p-6 space-y-4">
                <div>
                    <label class="block text-sm font-medium mb-1">OpenRouter API Key</label>
                    <input type="password" id="apiKeyInput" placeholder="sk-or-v1-..." class="w-full px-3 py-2 bg-gray-50 dark:bg-[#131314] border border-gray-300 dark:border-gray-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 dark:text-white">
                    <p class="text-xs text-gray-500 mt-1">Stored locally in your browser.</p>
                </div>
                <div>
                    <label class="block text-sm font-medium mb-1">Model Name</label>
                    <input type="text" id="modelInput" placeholder="deepseek/deepseek-r1:free" value="deepseek/deepseek-r1:free" class="w-full px-3 py-2 bg-gray-50 dark:bg-[#131314] border border-gray-300 dark:border-gray-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 dark:text-white">
                </div>
            </div>
            <div class="px-6 py-4 border-t border-gray-200 dark:border-gray-700 flex justify-end gap-3">
                <button onclick="closeModal('settingsModal')" class="px-4 py-2 text-sm font-medium hover:bg-gray-100 dark:hover:bg-gray-800 rounded-lg transition-colors">Cancel</button>
                <button onclick="saveSettings()" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-lg transition-colors">Save</button>
            </div>
        </div>
    </div>

    <!-- System Prompt Modal -->
    <div id="systemPromptModal" class="fixed inset-0 bg-black/60 z-[100] hidden flex items-center justify-center p-4">
        <div class="bg-white dark:bg-[#1e1f22] rounded-2xl w-full max-w-lg shadow-xl overflow-hidden transform scale-95 transition-transform">
            <div class="px-6 py-4 border-b border-gray-200 dark:border-gray-700 flex justify-between items-center">
                <h2 class="text-lg font-semibold">Global System Prompt</h2>
                <button onclick="closeModal('systemPromptModal')" class="text-gray-500 hover:text-gray-800 dark:hover:text-white">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div class="p-6">
                <textarea id="systemPromptInput" rows="5" placeholder="You are a helpful AI assistant..." class="w-full px-3 py-2 bg-gray-50 dark:bg-[#131314] border border-gray-300 dark:border-gray-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 dark:text-white resize-y"></textarea>
                <p class="text-xs text-gray-500 mt-2">This prompt guides the AI's behavior for all chats.</p>
            </div>
            <div class="px-6 py-4 border-t border-gray-200 dark:border-gray-700 flex justify-end gap-3">
                <button onclick="closeModal('systemPromptModal')" class="px-4 py-2 text-sm font-medium hover:bg-gray-100 dark:hover:bg-gray-800 rounded-lg transition-colors">Cancel</button>
                <button onclick="saveSystemPrompt()" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-lg transition-colors">Save</button>
            </div>
        </div>
    </div>

    <!-- MAIN JAVASCRIPT APPLICATION -->
    <script>
        // --- 1. STATE MANAGEMENT ---
        let appState = {
            apiKey: '',
            model: 'deepseek/deepseek-r1:free',
            systemPrompt: 'You are a helpful, intelligent assistant.',
            isDarkMode: false,
            chats: [],       // Array of { id, title, messages: [{role, content}] }
            currentChatId: null
        };

        let isGenerating = false;
        let abortController = null;

        // Configure Marked.js
        marked.use({
            breaks: true,
            gfm: true
        });

        // --- 2. INITIALIZATION ---
        function initApp() {
            try {
                loadState();
                applyTheme();
                
                if (appState.chats.length === 0) {
                    createNewChat();
                } else {
                    if (!appState.currentChatId) {
                        appState.currentChatId = appState.chats[0].id;
                    }
                    renderChatList();
                    loadCurrentChat();
                }

                // Setup textarea listener
                const input = document.getElementById('messageInput');
                autoResizeTextarea(input);
            } catch (e) {
                console.error("Initialization Error:", e);
                alert("Failed to initialize application.");
            }
        }

        // --- 3. STORAGE ---
        function loadState() {
            const saved = localStorage.getItem('aiChatState');
            if (saved) {
                const parsed = JSON.parse(saved);
                appState = { ...appState, ...parsed };
                
                // Fallback validation
                if (!Array.isArray(appState.chats)) appState.chats = [];
                if (!appState.model) appState.model = 'deepseek/deepseek-r1:free';
            }
        }

        function saveState() {
            localStorage.setItem('aiChatState', JSON.stringify(appState));
        }

        // --- 4. THEME & UI INTERACTIONS ---
        function toggleDarkMode() {
            appState.isDarkMode = !appState.isDarkMode;
            applyTheme();
            saveState();
        }

        function applyTheme() {
            const html = document.documentElement;
            const icon = document.getElementById('themeIcon');
            if (appState.isDarkMode) {
                html.classList.add('dark');
                icon.classList.remove('fa-moon');
                icon.classList.add('fa-sun');
            } else {
                html.classList.remove('dark');
                icon.classList.remove('fa-sun');
                icon.classList.add('fa-moon');
            }
        }

        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            const overlay = document.getElementById('sidebarOverlay');
            
            if (sidebar.classList.contains('-translate-x-full')) {
                // Open sidebar
                sidebar.classList.remove('-translate-x-full');
                overlay.classList.remove('hidden');
            } else {
                // Close sidebar
                sidebar.classList.add('-translate-x-full');
                overlay.classList.add('hidden');
            }
        }

        function autoResizeTextarea(element) {
            element.style.height = 'auto';
            element.style.height = (element.scrollHeight) + 'px';
        }

        // Modals Handling
        function openSettingsModal() {
            document.getElementById('apiKeyInput').value = appState.apiKey || '';
            document.getElementById('modelInput').value = appState.model || '';
            document.getElementById('settingsModal').classList.remove('hidden');
        }

        function saveSettings() {
            appState.apiKey = document.getElementById('apiKeyInput').value.trim();
            appState.model = document.getElementById('modelInput').value.trim() || 'deepseek/deepseek-r1:free';
            saveState();
            closeModal('settingsModal');
        }

        function openSystemPromptModal() {
            document.getElementById('systemPromptInput').value = appState.systemPrompt || '';
            document.getElementById('systemPromptModal').classList.remove('hidden');
        }

        function saveSystemPrompt() {
            appState.systemPrompt = document.getElementById('systemPromptInput').value.trim();
            saveState();
            closeModal('systemPromptModal');
        }

        // Common Modal Close
        function closeModal(id) {
            document.getElementById(id).classList.add('hidden');
        }

        // --- 5. CHAT MANAGEMENT ---
        function createNewChat() {
            const newChat = {
                id: Date.now().toString(),
                title: 'New Chat',
                messages: []
            };
            appState.chats.unshift(newChat);
            appState.currentChatId = newChat.id;
            saveState();
            renderChatList();
            loadCurrentChat();
            if(window.innerWidth < 768) toggleSidebar(); // auto close on mobile
        }

        function switchChat(id) {
            if (isGenerating) return;
            appState.currentChatId = id;
            saveState();
            renderChatList();
            loadCurrentChat();
            if(window.innerWidth < 768) toggleSidebar();
        }

        function deleteChat(id, event) {
            event.stopPropagation();
            if (!confirm('Are you sure you want to delete this chat?')) return;
            
            appState.chats = appState.chats.filter(c => c.id !== id);
            
            if (appState.chats.length === 0) {
                createNewChat();
            } else if (appState.currentChatId === id) {
                appState.currentChatId = appState.chats[0].id;
                loadCurrentChat();
            }
            
            saveState();
            renderChatList();
        }

        function renameChat(id, event) {
            event.stopPropagation();
            const chat = appState.chats.find(c => c.id === id);
            if (!chat) return;
            
            const newTitle = prompt('Enter new chat name:', chat.title);
            if (newTitle && newTitle.trim()) {
                chat.title = newTitle.trim();
                saveState();
                renderChatList();
                if (appState.currentChatId === id) {
                    document.getElementById('currentChatTitle').innerText = chat.title;
                }
            }
        }

        function renderChatList() {
            const listContainer = document.getElementById('chatHistoryList');
            if (!listContainer) return;
            
            listContainer.innerHTML = '';
            
            appState.chats.forEach(chat => {
                const isActive = chat.id === appState.currentChatId;
                const baseClasses = "group flex items-center justify-between w-full px-3 py-2.5 rounded-lg cursor-pointer transition-colors mb-1 text-sm";
                const activeClasses = isActive ? "bg-blue-100 dark:bg-[#383a40] text-blue-700 dark:text-white font-medium" : "text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-[#2b2d31]";
                
                const div = document.createElement('div');
                div.className = `${baseClasses} ${activeClasses}`;
                div.onclick = () => switchChat(chat.id);
                
                div.innerHTML = `
                    <div class="flex items-center gap-3 overflow-hidden">
                        <i class="far fa-message shrink-0 ${isActive ? 'text-blue-500 dark:text-gray-200' : 'text-gray-400 dark:text-gray-500'}"></i>
                        <span class="truncate block w-[140px] text-left">${escapeHTML(chat.title)}<
